---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

const { principles } = site;
---

<section class="section section--tight" id="principles" aria-labelledby="principles-title">
	<div class="container">
		<div class="principles-panel">
			<div class="principles-intro">
				<SectionHeading
					id="principles-title"
					eyebrow={principles.eyebrow}
					title={principles.title}
				/>
				<p class="lead">{principles.lead}</p>
			</div>

			<ul class="principles-list">
				{
					principles.items.map((item, index) => (
						<li class="principle" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
							<span class="principle-icon" aria-hidden="true">
								{item.icon === 'eu' && (
									<svg class="eu-flag" viewBox="0 0 24 16" focusable="false">
										<rect width="24" height="16" rx="1.5" fill="#003399" />
										<g fill="#FFCC00">
											<path d="M12.00 1.78L12.20 2.39L12.85 2.39L12.32 2.77L12.52 3.39L12.00 3.01L11.48 3.39L11.68 2.77L11.15 2.39L11.80 2.39Z" />
											<path d="M14.67 2.49L14.87 3.11L15.51 3.11L14.99 3.49L15.19 4.10L14.67 3.72L14.14 4.10L14.34 3.49L13.82 3.11L14.47 3.11Z" />
											<path d="M16.62 4.44L16.82 5.06L17.46 5.06L16.94 5.44L17.14 6.05L16.62 5.67L16.10 6.05L16.30 5.44L15.77 5.06L16.42 5.06Z" />
											<path d="M17.33 7.11L17.53 7.73L18.18 7.73L17.66 8.10L17.86 8.72L17.33 8.34L16.81 8.72L17.01 8.10L16.49 7.73L17.13 7.73Z" />
											<path d="M16.62 9.78L16.82 10.39L17.46 10.39L16.94 10.77L17.14 11.39L16.62 11.01L16.10 11.39L16.30 10.77L15.77 10.39L16.42 10.39Z" />
											<path d="M14.67 11.73L14.87 12.34L15.51 12.34L14.99 12.72L15.19 13.34L14.67 12.96L14.14 13.34L14.34 12.72L13.82 12.34L14.47 12.34Z" />
											<path d="M12.00 12.44L12.20 13.06L12.85 13.06L12.32 13.44L12.52 14.05L12.00 13.67L11.48 14.05L11.68 13.44L11.15 13.06L11.80 13.06Z" />
											<path d="M9.33 11.73L9.53 12.34L10.18 12.34L9.66 12.72L9.86 13.34L9.33 12.96L8.81 13.34L9.01 12.72L8.49 12.34L9.13 12.34Z" />
											<path d="M7.38 9.78L7.58 10.39L8.23 10.39L7.70 10.77L7.90 11.39L7.38 11.01L6.86 11.39L7.06 10.77L6.54 10.39L7.18 10.39Z" />
											<path d="M6.67 7.11L6.87 7.73L7.51 7.73L6.99 8.10L7.19 8.72L6.67 8.34L6.14 8.72L6.34 8.10L5.82 7.73L6.47 7.73Z" />
											<path d="M7.38 4.44L7.58 5.06L8.23 5.06L7.70 5.44L7.90 6.05L7.38 5.67L6.86 6.05L7.06 5.44L6.54 5.06L7.18 5.06Z" />
											<path d="M9.33 2.49L9.53 3.11L10.18 3.11L9.66 3.49L9.86 4.10L9.33 3.72L8.81 4.10L9.01 3.49L8.49 3.11L9.13 3.11Z" />
										</g>
									</svg>
								)}

								{item.icon === 'retention' && (
									<svg viewBox="0 0 24 24" fill="none" focusable="false">
										<ellipse cx="12" cy="5.5" rx="7" ry="2.5" stroke="currentColor" stroke-width="1.5" />
										<path
											d="M5 5.5v6.5c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5V5.5M5 12v6.5c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5V12"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
										/>
										<path d="M3.5 3l17 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
									</svg>
								)}

								{item.icon === 'opensource' && (
									<svg viewBox="0 0 24 24" fill="none" focusable="false">
										<path
											d="M9 7l-5 5 5 5M15 7l5 5-5 5M13.5 5l-3 14"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								)}
							</span>

							<div class="principle-body">
								<h3>{item.title}</h3>
								<p>
									{item.description}
									{'link' in item && item.link && (
										<>
											{' '}
											<a href={item.link.href} rel="noopener noreferrer" target="_blank">
												{item.link.label} <span aria-hidden="true">↗</span>
											</a>
										</>
									)}
								</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
