---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

const { principles } = site;
---

<section class="section section--tight" id="principles" aria-labelledby="principles-title">
	<div class="container">
		<div class="principles-panel">
			<div class="principles-intro">
				<SectionHeading
					id="principles-title"
					eyebrow={principles.eyebrow}
					title={principles.title}
				/>
				<p class="lead">{principles.lead}</p>
			</div>

			<ul class="principles-list">
				{
					principles.items.map((item, index) => (
						<li class="principle" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
							<span class="principle-icon" aria-hidden="true">
								{item.icon === 'eu' && (
									<svg class="eu-flag" viewBox="0 0 24 16" focusable="false">
										<rect width="24" height="16" rx="1.5" fill="#003399" />
										<g fill="#FFCC00">
											<path d="M12.00 7.15L12.20 7.72L12.81 7.74L12.32 8.11L12.50 8.69L12.00 8.34L11.50 8.69L11.68 8.11L11.19 7.74L11.80 7.72Z" />
											<path d="M12.43 7.26L12.31 7.86L12.83 8.18L12.23 8.25L12.09 8.85L11.83 8.29L11.22 8.35L11.67 7.93L11.43 7.37L11.96 7.66Z" />
											<path d="M12.74 7.58L12.34 8.04L12.63 8.57L12.07 8.33L11.65 8.78L11.71 8.17L11.15 7.91L11.75 7.77L11.82 7.17L12.14 7.69Z" />
											<path d="M12.85 8.00L12.28 8.20L12.26 8.81L11.89 8.32L11.31 8.50L11.66 8.00L11.31 7.50L11.89 7.68L12.26 7.19L12.28 7.80Z" />
											<path d="M12.74 8.43L12.14 8.31L11.82 8.83L11.75 8.23L11.15 8.09L11.71 7.83L11.65 7.22L12.07 7.67L12.63 7.43L12.34 7.96Z" />
											<path d="M12.43 8.74L11.96 8.34L11.43 8.63L11.67 8.07L11.22 7.65L11.83 7.71L12.09 7.15L12.23 7.75L12.83 7.82L12.31 8.14Z" />
											<path d="M12.00 8.85L11.80 8.28L11.19 8.26L11.68 7.89L11.50 7.31L12.00 7.66L12.50 7.31L12.32 7.89L12.81 8.26L12.20 8.28Z" />
											<path d="M11.57 8.74L11.69 8.14L11.17 7.82L11.77 7.75L11.91 7.15L12.17 7.71L12.78 7.65L12.33 8.07L12.57 8.63L12.04 8.34Z" />
											<path d="M11.26 8.43L11.66 7.96L11.37 7.43L11.93 7.67L12.35 7.22L12.29 7.83L12.85 8.09L12.25 8.23L12.18 8.83L11.86 8.31Z" />
											<path d="M11.15 8.00L11.72 7.80L11.74 7.19L12.11 7.68L12.69 7.50L12.34 8.00L12.69 8.50L12.11 8.32L11.74 8.81L11.72 8.20Z" />
											<path d="M11.26 7.58L11.86 7.69L12.18 7.17L12.25 7.77L12.85 7.91L12.29 8.17L12.35 8.78L11.93 8.33L11.37 8.57L11.66 8.04Z" />
											<path d="M11.57 7.26L12.04 7.66L12.57 7.37L12.33 7.93L12.78 8.35L12.17 8.29L11.91 8.85L11.77 8.25L11.17 8.18L11.69 7.86Z" />
										</g>
									</svg>
								)}

								{item.icon === 'retention' && (
									<svg viewBox="0 0 24 24" fill="none" focusable="false">
										<ellipse cx="12" cy="5.5" rx="7" ry="2.5" stroke="currentColor" stroke-width="1.5" />
										<path
											d="M5 5.5v6.5c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5V5.5M5 12v6.5c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5V12"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
										/>
										<path d="M3.5 3l17 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
									</svg>
								)}

								{item.icon === 'opensource' && (
									<svg viewBox="0 0 24 24" fill="none" focusable="false">
										<path
											d="M9 7l-5 5 5 5M15 7l5 5-5 5M13.5 5l-3 14"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								)}
							</span>

							<div class="principle-body">
								<h3>{item.title}</h3>
								<p>
									{item.description}
									{'link' in item && item.link && (
										<>
											{' '}
											<a href={item.link.href} rel="noopener noreferrer" target="_blank">
												{item.link.label} ↗
											</a>
										</>
									)}
								</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
