---
import Brand from './Brand.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
const { company, contact } = site;
const isHome = Astro.url.pathname === '/';
const sectionHref = (href: string) => (isHome ? href : `/${href}`);
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<Brand href={isHome ? '#top' : '/'} />
			<p>{site.tagline}</p>
		</div>

		<nav class="footer-col" aria-label="Services">
			<h2>Services</h2>
			<ul>
				{
					site.nav
						.filter((item) => item.href !== '#contact')
						.map((item) => (
							<li>
								<a href={sectionHref(item.href)}>{item.label}</a>
							</li>
						))
				}
			</ul>
		</nav>

		<nav class="footer-col" aria-label="Connect">
			<h2>Connect</h2>
			<ul>
				{
					contact.emails.map((email) => (
						<li><a href={email.href}>{email.address}</a></li>
					))
				}
				<li>
					<a href={site.github} rel="noopener noreferrer" target="_blank">GitHub</a>
				</li>
				<li><a href={sectionHref('#contact')}>Start a conversation</a></li>
				<li><a href="/privacy-policy">Privacy Policy</a></li>
			</ul>
		</nav>
	</div>

	<div class="container footer-bottom">
		<p>
			© {year} {company.legalName} All rights reserved. · Company ID (IČO): {company.companyId}
			{company.vatId && <> · {company.vatLabel}: {company.vatId}</>}
		</p>
		<a href="#top">Back to top ↑</a>
	</div>
</footer>
