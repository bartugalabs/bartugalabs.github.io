---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

const { contact, company } = site;
---

<section class="section" id="contact" aria-labelledby="contact-title">
	<div class="container">
		<div class="contact-panel">
			<div>
				<SectionHeading
					id="contact-title"
					eyebrow={contact.eyebrow}
					title={contact.title}
				/>
				<p class="contact-copy">{contact.copy}</p>

				<div class="contact-map" data-reveal>
					<iframe
						class="contact-map-iframe"
						src={company.map.embedUrl}
						title="OpenStreetMap location for {company.legalName}"
						loading="lazy"
						referrerpolicy="no-referrer"
					></iframe>
					<a class="contact-map-link" href={company.map.link} target="_blank" rel="noopener noreferrer">
						View larger map&nbsp;&#8599;
					</a>
				</div>
			</div>

			<div class="contact-card" data-reveal>
				<p class="contact-label">{contact.label}</p>
				<a class="button-primary contact-email" href={site.contactHref}>
					<span>{site.email}</span>
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path
							d="M3 8h10M9 4l4 4-4 4"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</a>

				<address class="contact-address">
					<strong>{company.legalName}</strong>
					<span>{company.street}</span>
					<span>{company.postalCode} {company.city}</span>
					<span>{company.country}</span>
					<a href={company.map.link} target="_blank" rel="noopener noreferrer">
						Open in OpenStreetMap&nbsp;&#8599;
					</a>
				</address>

				<p class="contact-vat">{company.vatLabel}: {company.vatId}</p>

				<dl class="contact-meta">
					{
						contact.details.map((detail) => (
							<div>
								<dt>{detail.label}</dt>
								<dd>{detail.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
	</div>
</section>