---
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';
import { site } from '../data/site';

const { agentSecurity } = site;
---

<section class="section" id="agent-security" aria-labelledby="agent-security-title" tabindex="-1">
	<div class="container">
		<SectionHeading
			id="agent-security-title"
			eyebrow={agentSecurity.eyebrow}
			title={agentSecurity.title}
			lead={agentSecurity.lead}
		/>

		<div class="grid">
			{
				agentSecurity.services.map((service, index) => (
					<ServiceCard
						index={String(index + 1).padStart(2, '0')}
						title={service.title}
						description={service.description}
						delay={index * 80}
					/>
				))
			}
		</div>

		<ul class="checklist" data-reveal>
			{agentSecurity.outcomes.map((outcome) => <li>{outcome}</li>)}
		</ul>

		<p class="link-row">
			<a href={site.contactHref}>
				{agentSecurity.cta}
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path
						d="M3 8h10M9 4l4 4-4 4"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
		</p>
	</div>
</section>
