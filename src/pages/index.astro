---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bartuga">
	<main class="stage">
		<div class="grid" aria-hidden="true"></div>
		<div class="glow" aria-hidden="true"></div>

		<section class="hero">
			<p class="prompt">~/bartuga</p>
			<h1 class="title">
				Bartuga<span class="cursor" aria-hidden="true"></span>
			</h1>
		</section>
	</main>
</Layout>

<style>
	.stage {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 100vh;
		min-height: 100svh;
		overflow: hidden;
		background:
			radial-gradient(120% 90% at 50% 40%, #0d2b52 0%, #08111f 55%, #05090f 100%);
		font-family:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
	}

	.grid,
	.glow {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.grid {
		background-image:
			linear-gradient(rgba(122, 162, 247, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(122, 162, 247, 0.06) 1px, transparent 1px);
		background-size: 48px 48px;
		mask-image: radial-gradient(70% 60% at 50% 45%, #000 0%, transparent 100%);
		-webkit-mask-image: radial-gradient(70% 60% at 50% 45%, #000 0%, transparent 100%);
	}

	.glow {
		background: radial-gradient(38% 26% at 50% 50%, rgba(56, 132, 255, 0.22) 0%, transparent 100%);
	}

	.hero {
		position: relative;
		z-index: 1;
		padding: 24px;
		text-align: center;
	}

	.prompt {
		margin: 0 0 14px;
		font-size: 13px;
		letter-spacing: 0.08em;
		color: #5d7aa8;
	}

	.prompt::before {
		content: '$ ';
		color: #7aa2f7;
	}

	.title {
		margin: 0;
		font-size: clamp(2rem, 9vw, 4.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.05;
		color: #e8eefc;
		text-shadow: 0 0 32px rgba(56, 132, 255, 0.28);
	}

	.cursor {
		display: inline-block;
		width: 0.55ch;
		height: 0.95em;
		margin-left: 0.12em;
		vertical-align: -0.08em;
		background: #7aa2f7;
		box-shadow: 0 0 14px rgba(122, 162, 247, 0.8);
		animation: blink 1.1s steps(1, end) infinite;
	}

	@keyframes blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}
</style>
